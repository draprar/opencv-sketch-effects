# Auto-detect text files and normalize line endings to LF in repository
* text=auto eol=lf

# Explicitly declare text files
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.sh text eol=lf
Makefile text eol=lf

# Declare files that should not be normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.tiff binary
*.tif binary

# Lock files
uv.lock text eol=lf
*.lock text eol=lf
